# App Server
PORT=3001
NODE_ENV=development

# Broker Credentials (Angel One SmartAPI)
API_KEY=
CLIENT_CODE=
CLIENT_PIN=
CLIENT_TOTP_PIN=

# Telegram Alerts & Control
USE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Alerts
USE_SLACK=false
SLACK_WEBHOOK_URL=

# BANKNIFTY 45-DTE Delta-Hedged Short Strangle Strategy Config (§3)
LOT_SIZE=30
TARGET_DTE=45
ENTRY_DTE_WINDOW=3
HARD_EXIT_DTE=15
SHORT_TARGET_DELTA=0.30
HEDGE_TARGET_DELTA_MIN=0.15
HEDGE_TARGET_DELTA_MAX=0.17
PT_PCT_OF_CREDIT=50
SL_PCT_OF_CREDIT=100
RISK_FREE_RATE=0.065
ENTRY_WINDOW_START_HOUR=15
ENTRY_WINDOW_START_MINUTE=0
ENTRY_WINDOW_END_HOUR=15
ENTRY_WINDOW_END_MINUTE=15
REPORT_HOUR=15
REPORT_MINUTE=40

# Execution mode: true = paper trading simulation, false = live broker trading
PAPER_MODE=true
